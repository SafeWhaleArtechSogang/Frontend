# Spring Boot API. 로컬에서는 Vite proxy를 사용하므로 상대 경로를 권장합니다.
VITE_API_BASE_URL=/api/v1

# Vite 개발 서버가 프록시할 백엔드 주소입니다.
# 통합 Docker Compose 검증 시에는 http://127.0.0.1:8088 을 사용합니다.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Kakao Maps Web JavaScript 키 예시. 실제 키는 .env.local에 넣으세요.
VITE_KAKAO_APP_KEY=your-kakao-javascript-key

# Google Identity Services Web Client ID입니다. 백엔드 GOOGLE_CLIENT_ID와 동일해야 합니다.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
